# Database
MONGO_URI=mongodb://localhost:27017/smart-incident

# Redis (for BullMQ job queues)
REDIS_URL=redis://localhost:6379

# Slack Incoming Webhook (optional - alerts will be skipped if not set)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# OpenAI API Key (optional - AI suggestions will be skipped if not set)
OPENAI_API_KEY=sk-your-api-key-here

# Server
PORT=3000
